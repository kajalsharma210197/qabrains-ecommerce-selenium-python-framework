  },
  {
    "name": "Product defects (assertion failures)",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*AssertionError.*|.*assert.*"
  },
  {
    "name": "Test defects (timeouts / logic)",
    "matchedStatuses": ["broken"],
    "messageRegex": ".*TimeoutException.*|.*RuntimeError.*|.*No product.*"
  },
  {
    "name": "Automation / infrastructure",
    "matchedStatuses": ["broken", "failed"],
    "messageRegex": ".*WebDriverException.*|.*invalid session.*|.*session deleted.*|.*Browser session.*"
  },
  {
    "name": "Ignored / skipped tests",
    "matchedStatuses": ["skipped"]
